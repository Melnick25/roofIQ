{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": "public",
  "build": {
    "env": {
      "NODE_VERSION": "20.x"
    }
  },
  "functions": {
    "api/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/dashboard", "dest": "/dashboard/index.html" },
    { "src": "/widget.js", "dest": "/public/widget.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}